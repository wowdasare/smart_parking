# Copy this file to .env and fill in real values. .env is gitignored.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: 'sqlite' (default, no setup needed) or 'mysql'
DB_ENGINE=sqlite
DB_NAME=atuparking
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email (SMTP) — leave EMAIL_HOST blank in dev to print emails to the console instead
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ATU Smart Parking <noreply@atuparking.local>
